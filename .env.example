# Leave unset to run the Snapshot entirely in the browser using the local
# strategy engine (src/lib/engine.js). No key, no network, always works.

# Point this at your own server route once you deploy api/strategy.js.
# VITE_AI_ENDPOINT=/api/strategy

# Server-side only. Never prefix this with VITE_ — that would ship it to the browser.
# ANTHROPIC_API_KEY=sk-ant-...
